{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-mcp",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "mcp/**/*.ts",
    "src/services/recon/contracts.ts",
    "electron/recon/**/*.ts",
    "electron/agent/**/*.ts",
    "src/services/agent/**/*.ts"
  ]
}
